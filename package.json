{
  "name": "experiment-chat",
  "version": "4.0.0",
  "private": true,
  "description": "实验平台（统一题目模型）：一切皆题目 — 实验是可复用的题目模板，问卷是一条链接 + 一列题目 + 计时默认值",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check-platform.js && node scripts/consistency-check.js",
    "check:platform": "node scripts/check-platform.js",
    "check:config": "node scripts/consistency-check.js",
    "shots": "node scripts/capture-shots.js",
    "probe": "node scripts/load-probe.js",
    "presets": "node scripts/seed-presets.js",
    "thinking": "node scripts/seed-thinking.js",
    "reset-db": "node scripts/reset-db.js",
    "portable": "node scripts/build-portable.js",
    "deploy": "node scripts/build-deploy.js",
    "sync-groups": "node scripts/sync-group-content.js"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
