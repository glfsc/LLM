# 运行时数据（可通过 npm run reset-db 重建，不入库）
data.db
data.db-wal
data.db-shm

# 依赖目录（本项目零第三方依赖，仍防误提交）
node_modules/

# 日志
*.log
npm-debug.log*

# 编辑器 / 系统文件
.aicoding-chat-workspace
.DS_Store
Thumbs.db

# 运行时上传（问卷实验题图片等，不入库）
uploads/

# 开发/自检过程截图不入库（仅保留 v3-* 文档定稿截图）
screenshots/*
!screenshots/v5-*
!screenshots/sv-*

# 设计预览走查截图（design/ 下的方案与预览页保留）
design/shots/

# 工具/临时目录
.tmp/
.zcode/
# Office 临时锁文件
~$*
