# 运行时数据（可通过 npm run reset-db 重建，不入库）
data.db
data.db-wal
data.db-shm

# 依赖目录（本项目零第三方依赖，仍防误提交）
node_modules/

# 日志
*.log
npm-debug.log*

# 编辑器 / 系统文件
.aicoding-chat-workspace
.DS_Store
Thumbs.db

# 运行时上传（问卷实验题图片等，不入库）
uploads/

# 开发/自检过程截图不入库（仅保留 v5-* 实验端与 sv-* 通用问卷定稿截图）
screenshots/*
!screenshots/v5-*
!screenshots/sv-*

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
